{
  "name": "@sim/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "bun": ">=1.2.13",
    "node": ">=20.0.0"
  },
  "exports": {
    ".": {
      "types": "./index.ts",
      "default": "./index.ts"
    },
    "./schema": {
      "types": "./schema.ts",
      "default": "./schema.ts"
    }
  },
  "scripts": {
    "db:push": "bun ../../node_modules/drizzle-kit/bin.cjs push --config=./drizzle.config.ts",
    "db:migrate": "bun ../../node_modules/drizzle-kit/bin.cjs migrate --config=./drizzle.config.ts && bun ../../node_modules/drizzle-kit/bin.cjs migrate --config=./drizzle-local.config.ts",
    "db:migrate:upstream": "bun ../../node_modules/drizzle-kit/bin.cjs migrate --config=./drizzle.config.ts",
    "db:migrate:local": "bun ../../node_modules/drizzle-kit/bin.cjs migrate --config=./drizzle-local.config.ts",
    "db:studio": "bun ../../node_modules/drizzle-kit/bin.cjs studio --config=./drizzle.config.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-kit": "^0.31.8",
    "drizzle-orm": "^0.44.5",
    "postgres": "^3.4.5",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@sim/tsconfig": "workspace:*",
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3"
  }
}
