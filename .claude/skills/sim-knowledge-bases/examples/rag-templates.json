{
  "templates": [
    {
      "name": "Basic RAG Q&A",
      "description": "Simple question-answering with knowledge base",
      "blocks": [
        {
          "type": "api_trigger",
          "name": "Question Input",
          "position": { "x": 100, "y": 100 }
        },
        {
          "type": "agent",
          "name": "RAG Agent",
          "position": { "x": 350, "y": 100 },
          "data": {
            "model": "gpt-4",
            "knowledgeBaseId": "{{variables.knowledgeBaseId}}",
            "systemPrompt": "You are a helpful assistant with access to our documentation. Answer questions based on the retrieved context. If the information isn't in the context, say you don't have that information."
          }
        },
        {
          "type": "response",
          "name": "Answer",
          "position": { "x": 600, "y": 100 },
          "data": {
            "data": "{{blocks.RAGAgent.output.response}}"
          }
        }
      ],
      "edges": [
        { "source": "Question Input", "target": "RAG Agent" },
        { "source": "RAG Agent", "target": "Answer" }
      ]
    },
    {
      "name": "Filtered RAG Search",
      "description": "RAG with metadata filtering",
      "blocks": [
        {
          "type": "api_trigger",
          "name": "Search Request",
          "position": { "x": 100, "y": 100 }
        },
        {
          "type": "agent",
          "name": "Filtered Search Agent",
          "position": { "x": 350, "y": 100 },
          "data": {
            "model": "gpt-4",
            "tools": ["knowledge_search"],
            "systemPrompt": "Search the knowledge base with the user's query. Apply category filter if specified. Return relevant results with source citations."
          }
        }
      ],
      "edges": [{ "source": "Search Request", "target": "Filtered Search Agent" }],
      "variables": [
        {
          "name": "knowledgeBaseId",
          "type": "string",
          "value": "kb_xxx"
        }
      ]
    },
    {
      "name": "Multi-Step RAG with Reranking",
      "description": "Search, rerank, then synthesize answer",
      "blocks": [
        {
          "type": "api_trigger",
          "name": "Complex Query",
          "position": { "x": 100, "y": 100 }
        },
        {
          "type": "agent",
          "name": "Initial Search",
          "position": { "x": 300, "y": 100 },
          "data": {
            "model": "gpt-4",
            "tools": ["knowledge_search"],
            "systemPrompt": "Search the knowledge base with topK=10. Return all results for reranking."
          }
        },
        {
          "type": "agent",
          "name": "Reranker",
          "position": { "x": 500, "y": 100 },
          "data": {
            "model": "gpt-4",
            "systemPrompt": "Given the search results and original question, rerank the results by relevance. Return the top 3 most relevant chunks with their content."
          }
        },
        {
          "type": "agent",
          "name": "Answer Synthesizer",
          "position": { "x": 700, "y": 100 },
          "data": {
            "model": "gpt-4",
            "systemPrompt": "Using the reranked search results, provide a comprehensive answer to the user's question. Cite sources by document name."
          }
        }
      ],
      "edges": [
        { "source": "Complex Query", "target": "Initial Search" },
        { "source": "Initial Search", "target": "Reranker" },
        { "source": "Reranker", "target": "Answer Synthesizer" }
      ]
    },
    {
      "name": "Conversational RAG",
      "description": "RAG with conversation history",
      "blocks": [
        {
          "type": "api_trigger",
          "name": "Chat Input",
          "position": { "x": 100, "y": 100 }
        },
        {
          "type": "agent",
          "name": "Conversation RAG",
          "position": { "x": 350, "y": 100 },
          "data": {
            "model": "gpt-4",
            "knowledgeBaseId": "{{variables.knowledgeBaseId}}",
            "systemPrompt": "You are a conversational assistant with access to our knowledge base. Consider the conversation history when answering. Reference previous answers if relevant."
          }
        }
      ],
      "edges": [{ "source": "Chat Input", "target": "Conversation RAG" }]
    },
    {
      "name": "Document Q&A with Citations",
      "description": "Answer with source citations",
      "blocks": [
        {
          "type": "api_trigger",
          "name": "Question",
          "position": { "x": 100, "y": 100 }
        },
        {
          "type": "agent",
          "name": "Citation Agent",
          "position": { "x": 350, "y": 100 },
          "data": {
            "model": "gpt-4",
            "tools": ["knowledge_search"],
            "systemPrompt": "Search the knowledge base and answer the question. For each fact in your answer, include a citation in [Source: document_name] format. List all sources at the end."
          }
        }
      ],
      "edges": [{ "source": "Question", "target": "Citation Agent" }]
    }
  ],
  "searchConfigurations": {
    "preciseAnswers": {
      "topK": 3,
      "description": "When you need specific, accurate answers"
    },
    "comprehensiveResearch": {
      "topK": 10,
      "description": "When gathering broad information on a topic"
    },
    "codeSamples": {
      "topK": 5,
      "tagFilters": [{ "tagName": "type", "tagValue": "code" }],
      "description": "Finding code examples"
    },
    "recentDocs": {
      "topK": 5,
      "tagFilters": [{ "tagName": "updated", "operator": "gt", "tagValue": "2024-01-01" }],
      "description": "Prefer recently updated documentation"
    }
  }
}
