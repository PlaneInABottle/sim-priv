{
  "templates": [
    {
      "name": "Cost Monitoring Workflow",
      "description": "Daily cost monitoring with alerts",
      "blocks": [
        {
          "id": "trigger_1",
          "type": "schedule",
          "name": "Daily Check",
          "position": { "x": 100, "y": 100 },
          "data": {
            "schedule": "0 9 * * *",
            "timezone": "UTC"
          }
        },
        {
          "id": "code_1",
          "type": "function",
          "name": "Calculate Metrics",
          "position": { "x": 300, "y": 100 },
          "data": {
            "code": "const usage = await fetch('/api/usage').then(r => r.json());\nconst projection = (usage.currentPeriodCost / dayOfMonth) * 30;\nreturn { usage, projection, percentUsed: usage.percentUsed };"
          }
        },
        {
          "id": "condition_1",
          "type": "condition",
          "name": "Check Threshold",
          "position": { "x": 500, "y": 100 },
          "data": {
            "condition": "{{code_1.percentUsed}} > 80"
          }
        },
        {
          "id": "agent_1",
          "type": "agent",
          "name": "Generate Alert",
          "position": { "x": 700, "y": 50 },
          "data": {
            "model": "gpt-4o-mini",
            "systemPrompt": "Generate a brief cost alert summary.",
            "maxTokens": 200
          }
        },
        {
          "id": "webhook_1",
          "type": "webhook_request",
          "name": "Send to Slack",
          "position": { "x": 900, "y": 50 },
          "data": {
            "url": "{{variables.slackWebhook}}",
            "method": "POST"
          }
        }
      ],
      "edges": [
        { "id": "e1", "source": "trigger_1", "target": "code_1" },
        { "id": "e2", "source": "code_1", "target": "condition_1" },
        { "id": "e3", "source": "condition_1", "target": "agent_1", "sourceHandle": "true" },
        { "id": "e4", "source": "agent_1", "target": "webhook_1" }
      ],
      "variables": [{ "name": "slackWebhook", "type": "string", "value": "" }]
    },
    {
      "name": "Model Selector",
      "description": "Route requests to cost-appropriate models",
      "blocks": [
        {
          "id": "trigger_1",
          "type": "api_trigger",
          "name": "API Trigger",
          "position": { "x": 100, "y": 150 }
        },
        {
          "id": "router_1",
          "type": "router",
          "name": "Select Model",
          "position": { "x": 300, "y": 150 },
          "data": {
            "routes": [
              {
                "name": "Simple",
                "condition": "{{input.complexity}} === 'simple'"
              },
              {
                "name": "Complex",
                "condition": "{{input.complexity}} === 'complex'"
              },
              {
                "name": "Critical",
                "condition": "{{input.complexity}} === 'critical'"
              }
            ]
          }
        },
        {
          "id": "agent_simple",
          "type": "agent",
          "name": "Fast Model",
          "position": { "x": 550, "y": 50 },
          "data": {
            "model": "gpt-4o-mini",
            "maxTokens": 500
          }
        },
        {
          "id": "agent_complex",
          "type": "agent",
          "name": "Standard Model",
          "position": { "x": 550, "y": 150 },
          "data": {
            "model": "gpt-4o",
            "maxTokens": 1000
          }
        },
        {
          "id": "agent_critical",
          "type": "agent",
          "name": "Premium Model",
          "position": { "x": 550, "y": 250 },
          "data": {
            "model": "claude-3-5-sonnet",
            "maxTokens": 2000
          }
        }
      ],
      "edges": [
        { "id": "e1", "source": "trigger_1", "target": "router_1" },
        { "id": "e2", "source": "router_1", "target": "agent_simple", "sourceHandle": "Simple" },
        { "id": "e3", "source": "router_1", "target": "agent_complex", "sourceHandle": "Complex" },
        { "id": "e4", "source": "router_1", "target": "agent_critical", "sourceHandle": "Critical" }
      ]
    },
    {
      "name": "Cache Implementation",
      "description": "Cache LLM responses to reduce costs",
      "blocks": [
        {
          "id": "trigger_1",
          "type": "api_trigger",
          "name": "API Trigger",
          "position": { "x": 100, "y": 100 }
        },
        {
          "id": "code_hash",
          "type": "function",
          "name": "Generate Cache Key",
          "position": { "x": 300, "y": 100 },
          "data": {
            "code": "const crypto = require('crypto');\nconst key = crypto.createHash('md5').update(input.prompt).digest('hex');\nreturn { cacheKey: `llm:${key}` };"
          }
        },
        {
          "id": "api_cache_get",
          "type": "api",
          "name": "Check Cache",
          "position": { "x": 500, "y": 100 },
          "data": {
            "url": "{{variables.redisUrl}}/get/{{code_hash.cacheKey}}",
            "method": "GET"
          }
        },
        {
          "id": "condition_1",
          "type": "condition",
          "name": "Cache Hit?",
          "position": { "x": 700, "y": 100 },
          "data": {
            "condition": "{{api_cache_get.response.value}} !== null"
          }
        },
        {
          "id": "agent_1",
          "type": "agent",
          "name": "LLM Call",
          "position": { "x": 900, "y": 150 },
          "data": {
            "model": "gpt-4o-mini"
          }
        },
        {
          "id": "api_cache_set",
          "type": "api",
          "name": "Store in Cache",
          "position": { "x": 1100, "y": 150 },
          "data": {
            "url": "{{variables.redisUrl}}/set",
            "method": "POST",
            "body": {
              "key": "{{code_hash.cacheKey}}",
              "value": "{{agent_1.response}}",
              "ttl": 3600
            }
          }
        }
      ],
      "edges": [
        { "id": "e1", "source": "trigger_1", "target": "code_hash" },
        { "id": "e2", "source": "code_hash", "target": "api_cache_get" },
        { "id": "e3", "source": "api_cache_get", "target": "condition_1" },
        { "id": "e4", "source": "condition_1", "target": "agent_1", "sourceHandle": "false" },
        { "id": "e5", "source": "agent_1", "target": "api_cache_set" }
      ],
      "variables": [{ "name": "redisUrl", "type": "string", "value": "" }]
    },
    {
      "name": "Batch Processor",
      "description": "Process items in batches for efficiency",
      "blocks": [
        {
          "id": "trigger_1",
          "type": "api_trigger",
          "name": "API Trigger",
          "position": { "x": 100, "y": 100 }
        },
        {
          "id": "code_batch",
          "type": "function",
          "name": "Create Batches",
          "position": { "x": 300, "y": 100 },
          "data": {
            "code": "const items = input.items;\nconst batchSize = 10;\nconst batches = [];\nfor (let i = 0; i < items.length; i += batchSize) {\n  batches.push(items.slice(i, i + batchSize));\n}\nreturn { batches };"
          }
        },
        {
          "id": "agent_1",
          "type": "agent",
          "name": "Process Batch",
          "position": { "x": 500, "y": 100 },
          "data": {
            "model": "gpt-4o-mini",
            "systemPrompt": "Process these items and return results as JSON array.",
            "maxTokens": 1000
          }
        },
        {
          "id": "code_merge",
          "type": "function",
          "name": "Merge Results",
          "position": { "x": 700, "y": 100 },
          "data": {
            "code": "const results = blocks.agent_1.output;\nreturn { results, count: Array.isArray(results) ? results.length : 1 };"
          }
        }
      ],
      "edges": [
        { "id": "e1", "source": "trigger_1", "target": "code_batch" },
        { "id": "e2", "source": "code_batch", "target": "agent_1" },
        { "id": "e3", "source": "agent_1", "target": "code_merge" }
      ],
      "loops": [
        {
          "id": "batch_loop",
          "type": "loop",
          "loopType": "forEach",
          "forEachItems": "{{blocks.code_batch.output.batches}}",
          "nodes": ["agent_1"]
        }
      ]
    },
    {
      "name": "Cost Alert Workflow",
      "description": "Real-time cost spike detection",
      "blocks": [
        {
          "id": "trigger_1",
          "type": "schedule",
          "name": "Hourly Check",
          "position": { "x": 100, "y": 100 },
          "data": {
            "schedule": "0 * * * *"
          }
        },
        {
          "id": "code_1",
          "type": "function",
          "name": "Analyze Costs",
          "position": { "x": 300, "y": 100 },
          "data": {
            "code": "const hourlyAvg = variables.dailyBudget / 24;\nconst currentHourCost = await getCurrentHourCost();\nconst isSpike = currentHourCost > hourlyAvg * 3;\nconst isCritical = currentHourCost > hourlyAvg * 5;\nreturn { currentHourCost, hourlyAvg, isSpike, isCritical };"
          }
        },
        {
          "id": "condition_1",
          "type": "condition",
          "name": "Is Spike?",
          "position": { "x": 500, "y": 100 },
          "data": {
            "condition": "{{code_1.isSpike}} === true"
          }
        },
        {
          "id": "router_1",
          "type": "router",
          "name": "Severity",
          "position": { "x": 700, "y": 50 },
          "data": {
            "routes": [
              { "name": "Critical", "condition": "{{code_1.isCritical}}" },
              { "name": "Warning", "condition": "!{{code_1.isCritical}}" }
            ]
          }
        },
        {
          "id": "webhook_critical",
          "type": "webhook_request",
          "name": "PagerDuty Alert",
          "position": { "x": 900, "y": 0 },
          "data": {
            "url": "{{variables.pagerdutyUrl}}",
            "method": "POST"
          }
        },
        {
          "id": "webhook_warning",
          "type": "webhook_request",
          "name": "Slack Warning",
          "position": { "x": 900, "y": 100 },
          "data": {
            "url": "{{variables.slackWebhook}}",
            "method": "POST"
          }
        }
      ],
      "edges": [
        { "id": "e1", "source": "trigger_1", "target": "code_1" },
        { "id": "e2", "source": "code_1", "target": "condition_1" },
        { "id": "e3", "source": "condition_1", "target": "router_1", "sourceHandle": "true" },
        {
          "id": "e4",
          "source": "router_1",
          "target": "webhook_critical",
          "sourceHandle": "Critical"
        },
        { "id": "e5", "source": "router_1", "target": "webhook_warning", "sourceHandle": "Warning" }
      ],
      "variables": [
        { "name": "dailyBudget", "type": "number", "value": 100 },
        { "name": "slackWebhook", "type": "string", "value": "" },
        { "name": "pagerdutyUrl", "type": "string", "value": "" }
      ]
    }
  ]
}
