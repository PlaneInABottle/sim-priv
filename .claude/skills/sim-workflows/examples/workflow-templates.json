{
  "simple_agent": {
    "name": "Simple Agent Workflow",
    "description": "Basic workflow with API trigger and AI agent",
    "blocks": [
      {
        "id": "trigger_1",
        "type": "api_trigger",
        "name": "API Trigger",
        "position": { "x": 100, "y": 100 },
        "data": {}
      },
      {
        "id": "agent_1",
        "type": "agent",
        "name": "AI Assistant",
        "position": { "x": 400, "y": 100 },
        "data": {
          "model": "gpt-4",
          "systemPrompt": "You are a helpful assistant.",
          "temperature": 0.7
        }
      },
      {
        "id": "response_1",
        "type": "response",
        "name": "Return Response",
        "position": { "x": 700, "y": 100 },
        "data": {
          "data": "{{blocks.agent_1.output}}"
        }
      }
    ],
    "edges": [
      {
        "id": "edge_1",
        "source": "trigger_1",
        "target": "agent_1"
      },
      {
        "id": "edge_2",
        "source": "agent_1",
        "target": "response_1"
      }
    ]
  },

  "conditional_routing": {
    "name": "Conditional Routing",
    "description": "Route to different agents based on condition",
    "blocks": [
      {
        "id": "trigger_1",
        "type": "api_trigger",
        "name": "API Trigger",
        "position": { "x": 100, "y": 150 }
      },
      {
        "id": "condition_1",
        "type": "condition",
        "name": "Check Priority",
        "position": { "x": 350, "y": 150 },
        "data": {
          "condition": "{{input.priority}} === 'high'"
        }
      },
      {
        "id": "agent_high",
        "type": "agent",
        "name": "Priority Agent",
        "position": { "x": 600, "y": 50 },
        "data": {
          "model": "gpt-4",
          "systemPrompt": "You are a priority support agent."
        }
      },
      {
        "id": "agent_standard",
        "type": "agent",
        "name": "Standard Agent",
        "position": { "x": 600, "y": 250 },
        "data": {
          "model": "gpt-3.5-turbo",
          "systemPrompt": "You are a standard support agent."
        }
      },
      {
        "id": "response_1",
        "type": "response",
        "name": "Return Response",
        "position": { "x": 900, "y": 150 }
      }
    ],
    "edges": [
      {
        "source": "trigger_1",
        "target": "condition_1"
      },
      {
        "source": "condition_1",
        "target": "agent_high",
        "sourceHandle": "true"
      },
      {
        "source": "condition_1",
        "target": "agent_standard",
        "sourceHandle": "false"
      },
      {
        "source": "agent_high",
        "target": "response_1"
      },
      {
        "source": "agent_standard",
        "target": "response_1"
      }
    ]
  },

  "api_integration": {
    "name": "API Integration",
    "description": "Fetch data from external API and process with agent",
    "blocks": [
      {
        "id": "trigger_1",
        "type": "api_trigger",
        "name": "API Trigger",
        "position": { "x": 100, "y": 100 }
      },
      {
        "id": "api_1",
        "type": "api",
        "name": "Fetch User Data",
        "position": { "x": 350, "y": 100 },
        "data": {
          "method": "GET",
          "url": "https://api.example.com/users/{{input.userId}}",
          "headers": {
            "Authorization": "Bearer {{variables.apiKey}}"
          }
        }
      },
      {
        "id": "agent_1",
        "type": "agent",
        "name": "Process Data",
        "position": { "x": 600, "y": 100 },
        "data": {
          "model": "gpt-4",
          "systemPrompt": "Analyze the user data and provide insights."
        }
      },
      {
        "id": "response_1",
        "type": "response",
        "name": "Return Response",
        "position": { "x": 850, "y": 100 }
      }
    ],
    "edges": [
      {
        "source": "trigger_1",
        "target": "api_1"
      },
      {
        "source": "api_1",
        "target": "agent_1"
      },
      {
        "source": "agent_1",
        "target": "response_1"
      }
    ],
    "variables": [
      {
        "id": "var_1",
        "name": "apiKey",
        "type": "string",
        "value": "your-api-key-here"
      }
    ]
  },

  "loop_processing": {
    "name": "Loop Processing",
    "description": "Process array items with agent in a loop",
    "blocks": [
      {
        "id": "trigger_1",
        "type": "api_trigger",
        "name": "API Trigger",
        "position": { "x": 100, "y": 100 }
      },
      {
        "id": "loop_1",
        "type": "loop",
        "name": "Process Items",
        "position": { "x": 350, "y": 100 },
        "data": {
          "type": "forEach",
          "array": "{{input.items}}",
          "maxIterations": 100
        }
      },
      {
        "id": "agent_1",
        "type": "agent",
        "name": "Process Item",
        "position": { "x": 600, "y": 100 },
        "data": {
          "model": "gpt-3.5-turbo",
          "systemPrompt": "Analyze the item: {{loop.current}}"
        }
      },
      {
        "id": "response_1",
        "type": "response",
        "name": "Return Results",
        "position": { "x": 850, "y": 100 },
        "data": {
          "data": "{{blocks.loop_1.output}}"
        }
      }
    ],
    "edges": [
      {
        "source": "trigger_1",
        "target": "loop_1"
      },
      {
        "source": "loop_1",
        "target": "agent_1"
      },
      {
        "source": "agent_1",
        "target": "response_1"
      }
    ]
  },

  "knowledge_base_rag": {
    "name": "Knowledge Base RAG",
    "description": "Retrieval augmented generation using knowledge base",
    "blocks": [
      {
        "id": "trigger_1",
        "type": "api_trigger",
        "name": "API Trigger",
        "position": { "x": 100, "y": 100 }
      },
      {
        "id": "kb_1",
        "type": "knowledge_base",
        "name": "Search Knowledge Base",
        "position": { "x": 350, "y": 100 },
        "data": {
          "knowledgeBaseId": "kb_123",
          "query": "{{input.question}}",
          "limit": 5,
          "minScore": 0.7
        }
      },
      {
        "id": "agent_1",
        "type": "agent",
        "name": "Answer Question",
        "position": { "x": 600, "y": 100 },
        "data": {
          "model": "gpt-4",
          "systemPrompt": "Answer the question using the provided context:\n\nContext: {{blocks.kb_1.output}}\n\nQuestion: {{input.question}}"
        }
      },
      {
        "id": "response_1",
        "type": "response",
        "name": "Return Answer",
        "position": { "x": 850, "y": 100 }
      }
    ],
    "edges": [
      {
        "source": "trigger_1",
        "target": "kb_1"
      },
      {
        "source": "kb_1",
        "target": "agent_1"
      },
      {
        "source": "agent_1",
        "target": "response_1"
      }
    ]
  },

  "parallel_processing": {
    "name": "Parallel Processing",
    "description": "Execute multiple agents in parallel",
    "blocks": [
      {
        "id": "trigger_1",
        "type": "api_trigger",
        "name": "API Trigger",
        "position": { "x": 100, "y": 200 }
      },
      {
        "id": "parallel_1",
        "type": "parallel",
        "name": "Parallel Agents",
        "position": { "x": 350, "y": 200 },
        "data": {
          "waitForAll": true
        }
      },
      {
        "id": "agent_1",
        "type": "agent",
        "name": "Sentiment Analysis",
        "position": { "x": 600, "y": 50 },
        "data": {
          "model": "gpt-3.5-turbo",
          "systemPrompt": "Analyze sentiment of: {{input.text}}"
        }
      },
      {
        "id": "agent_2",
        "type": "agent",
        "name": "Entity Extraction",
        "position": { "x": 600, "y": 200 },
        "data": {
          "model": "gpt-3.5-turbo",
          "systemPrompt": "Extract entities from: {{input.text}}"
        }
      },
      {
        "id": "agent_3",
        "type": "agent",
        "name": "Summarization",
        "position": { "x": 600, "y": 350 },
        "data": {
          "model": "gpt-3.5-turbo",
          "systemPrompt": "Summarize: {{input.text}}"
        }
      },
      {
        "id": "response_1",
        "type": "response",
        "name": "Return Combined Results",
        "position": { "x": 900, "y": 200 },
        "data": {
          "data": {
            "sentiment": "{{blocks.agent_1.output}}",
            "entities": "{{blocks.agent_2.output}}",
            "summary": "{{blocks.agent_3.output}}"
          }
        }
      }
    ],
    "edges": [
      {
        "source": "trigger_1",
        "target": "parallel_1"
      },
      {
        "source": "parallel_1",
        "target": "agent_1"
      },
      {
        "source": "parallel_1",
        "target": "agent_2"
      },
      {
        "source": "parallel_1",
        "target": "agent_3"
      },
      {
        "source": "agent_1",
        "target": "response_1"
      },
      {
        "source": "agent_2",
        "target": "response_1"
      },
      {
        "source": "agent_3",
        "target": "response_1"
      }
    ]
  },

  "error_handling": {
    "name": "Error Handling",
    "description": "Workflow with error handling and fallback",
    "blocks": [
      {
        "id": "trigger_1",
        "type": "api_trigger",
        "name": "API Trigger",
        "position": { "x": 100, "y": 150 }
      },
      {
        "id": "api_1",
        "type": "api",
        "name": "External API Call",
        "position": { "x": 350, "y": 150 },
        "data": {
          "method": "GET",
          "url": "{{input.apiUrl}}",
          "timeout": 5000,
          "onError": {
            "continueOnError": true
          }
        }
      },
      {
        "id": "condition_1",
        "type": "condition",
        "name": "Check Success",
        "position": { "x": 600, "y": 150 },
        "data": {
          "condition": "{{blocks.api_1.output.status}} === 200"
        }
      },
      {
        "id": "agent_success",
        "type": "agent",
        "name": "Process Success",
        "position": { "x": 850, "y": 50 },
        "data": {
          "model": "gpt-4",
          "systemPrompt": "Process successful API response"
        }
      },
      {
        "id": "agent_error",
        "type": "agent",
        "name": "Handle Error",
        "position": { "x": 850, "y": 250 },
        "data": {
          "model": "gpt-4",
          "systemPrompt": "Generate fallback response for API error"
        }
      },
      {
        "id": "response_1",
        "type": "response",
        "name": "Return Response",
        "position": { "x": 1100, "y": 150 }
      }
    ],
    "edges": [
      {
        "source": "trigger_1",
        "target": "api_1"
      },
      {
        "source": "api_1",
        "target": "condition_1"
      },
      {
        "source": "condition_1",
        "target": "agent_success",
        "sourceHandle": "true"
      },
      {
        "source": "condition_1",
        "target": "agent_error",
        "sourceHandle": "false"
      },
      {
        "source": "agent_success",
        "target": "response_1"
      },
      {
        "source": "agent_error",
        "target": "response_1"
      }
    ]
  }
}
