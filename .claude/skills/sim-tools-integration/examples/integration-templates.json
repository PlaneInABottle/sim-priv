{
  "templates": [
    {
      "name": "Slack Notification on Event",
      "description": "Send Slack message when workflow completes",
      "blocks": [
        {
          "type": "api_trigger",
          "name": "Webhook Trigger",
          "position": { "x": 100, "y": 100 }
        },
        {
          "type": "agent",
          "name": "Slack Notifier",
          "position": { "x": 350, "y": 100 },
          "data": {
            "model": "gpt-4",
            "tools": ["slack_message"],
            "systemPrompt": "Send a formatted Slack message to the #notifications channel summarizing the incoming data."
          }
        }
      ],
      "edges": [{ "source": "Webhook Trigger", "target": "Slack Notifier" }]
    },
    {
      "name": "Email to Linear Issue",
      "description": "Create Linear issues from Gmail emails",
      "blocks": [
        {
          "type": "api_trigger",
          "name": "Email Webhook",
          "position": { "x": 100, "y": 100 }
        },
        {
          "type": "agent",
          "name": "Issue Creator",
          "position": { "x": 350, "y": 100 },
          "data": {
            "model": "gpt-4",
            "tools": ["linear_create_issue"],
            "systemPrompt": "Extract issue details from the email:\n- Title: Email subject\n- Description: Summarize email body\n- Priority: Infer from urgency words\nCreate a Linear issue with this information."
          }
        }
      ],
      "edges": [{ "source": "Email Webhook", "target": "Issue Creator" }]
    },
    {
      "name": "Database Query with Slack Report",
      "description": "Query PostgreSQL and send results to Slack",
      "blocks": [
        {
          "type": "api_trigger",
          "name": "Schedule Trigger",
          "position": { "x": 100, "y": 100 }
        },
        {
          "type": "agent",
          "name": "Data Analyzer",
          "position": { "x": 350, "y": 100 },
          "data": {
            "model": "gpt-4",
            "tools": ["postgresql_query", "slack_message"],
            "systemPrompt": "Query the orders table for today's sales summary. Format the results and send to #sales-reports channel."
          }
        }
      ],
      "edges": [{ "source": "Schedule Trigger", "target": "Data Analyzer" }]
    },
    {
      "name": "S3 File Processing",
      "description": "Process files from S3 and store results",
      "blocks": [
        {
          "type": "api_trigger",
          "name": "S3 Event",
          "position": { "x": 100, "y": 100 }
        },
        {
          "type": "agent",
          "name": "File Processor",
          "position": { "x": 350, "y": 100 },
          "data": {
            "model": "gpt-4",
            "tools": ["s3_get_object", "s3_put_object"],
            "systemPrompt": "Download the file from the provided S3 path, analyze its contents, and save a summary to the same bucket with '-summary' suffix."
          }
        }
      ],
      "edges": [{ "source": "S3 Event", "target": "File Processor" }]
    },
    {
      "name": "GitHub PR Review Notifier",
      "description": "Notify Discord when PR needs review",
      "blocks": [
        {
          "type": "api_trigger",
          "name": "GitHub Webhook",
          "position": { "x": 100, "y": 100 }
        },
        {
          "type": "condition",
          "name": "Check PR Action",
          "position": { "x": 300, "y": 100 },
          "data": {
            "condition": "{{input.action}} === 'review_requested'"
          }
        },
        {
          "type": "agent",
          "name": "Discord Notifier",
          "position": { "x": 500, "y": 50 },
          "data": {
            "model": "gpt-4",
            "tools": ["discord_send_message"],
            "systemPrompt": "Send a message to the #code-reviews channel about the new PR awaiting review. Include PR title, author, and link."
          }
        }
      ],
      "edges": [
        { "source": "GitHub Webhook", "target": "Check PR Action" },
        { "source": "Check PR Action", "target": "Discord Notifier", "sourceHandle": "true" }
      ]
    },
    {
      "name": "Multi-Service Sync",
      "description": "Sync data between Notion and Google Sheets",
      "blocks": [
        {
          "type": "api_trigger",
          "name": "Sync Trigger",
          "position": { "x": 100, "y": 100 }
        },
        {
          "type": "agent",
          "name": "Data Syncer",
          "position": { "x": 350, "y": 100 },
          "data": {
            "model": "gpt-4",
            "tools": ["notion_query_database", "google_sheets_append"],
            "systemPrompt": "Query the Notion CRM database for entries created today. For each entry, append a row to the Google Sheet with: Name, Email, Company, Created Date."
          }
        }
      ],
      "edges": [{ "source": "Sync Trigger", "target": "Data Syncer" }]
    }
  ],
  "toolCombinations": {
    "communication": {
      "tools": ["slack_message", "discord_send_message", "gmail_send", "twilio_send_sms"],
      "useCase": "Multi-channel notifications"
    },
    "projectManagement": {
      "tools": ["linear_create_issue", "jira_create_issue", "notion_create_page"],
      "useCase": "Task creation and tracking"
    },
    "dataSync": {
      "tools": ["postgresql_query", "google_sheets_append", "notion_query_database"],
      "useCase": "Cross-platform data synchronization"
    },
    "fileManagement": {
      "tools": ["s3_get_object", "s3_put_object", "google_drive_upload"],
      "useCase": "File processing and storage"
    }
  }
}
