{
  "templates": [
    {
      "name": "Error Handling Workflow",
      "description": "Workflow with error handling and notification",
      "blocks": [
        {
          "type": "api_trigger",
          "name": "Request",
          "position": { "x": 100, "y": 100 }
        },
        {
          "type": "agent",
          "name": "Main Agent",
          "position": { "x": 300, "y": 100 },
          "data": {
            "model": "gpt-4",
            "onError": {
              "continueOnError": true,
              "errorHandler": "Error Handler"
            }
          }
        },
        {
          "type": "condition",
          "name": "Check Success",
          "position": { "x": 500, "y": 100 },
          "data": {
            "condition": "{{blocks.MainAgent.output.success}} === true"
          }
        },
        {
          "type": "response",
          "name": "Success Response",
          "position": { "x": 700, "y": 50 },
          "data": {
            "data": "{{blocks.MainAgent.output}}"
          }
        },
        {
          "type": "agent",
          "name": "Error Handler",
          "position": { "x": 700, "y": 150 },
          "data": {
            "model": "gpt-4",
            "tools": ["slack_message"],
            "systemPrompt": "An error occurred. Send alert to #errors channel with error details, then return error response."
          }
        }
      ],
      "edges": [
        { "source": "Request", "target": "Main Agent" },
        { "source": "Main Agent", "target": "Check Success" },
        { "source": "Check Success", "target": "Success Response", "sourceHandle": "true" },
        { "source": "Check Success", "target": "Error Handler", "sourceHandle": "false" }
      ]
    },
    {
      "name": "Retry Pattern",
      "description": "Retry failed operations with exponential backoff",
      "blocks": [
        {
          "type": "api_trigger",
          "name": "Trigger",
          "position": { "x": 100, "y": 100 }
        },
        {
          "type": "loop",
          "name": "Retry Loop",
          "position": { "x": 300, "y": 100 },
          "data": {
            "type": "while",
            "maxIterations": 3,
            "condition": "{{variables.lastAttemptFailed}}"
          }
        },
        {
          "type": "code",
          "name": "Backoff Delay",
          "position": { "x": 350, "y": 200 },
          "data": {
            "code": "const delay = Math.pow(2, {{loop.index}}) * 1000; await new Promise(r => setTimeout(r, delay)); return input;"
          }
        },
        {
          "type": "agent",
          "name": "API Operation",
          "position": { "x": 500, "y": 200 }
        }
      ],
      "edges": [
        { "source": "Trigger", "target": "Retry Loop" },
        { "source": "Retry Loop", "target": "Backoff Delay" },
        { "source": "Backoff Delay", "target": "API Operation" }
      ],
      "variables": [{ "name": "lastAttemptFailed", "type": "boolean", "value": true }]
    },
    {
      "name": "Debug Logger",
      "description": "Add logging to troubleshoot workflows",
      "blocks": [
        {
          "type": "api_trigger",
          "name": "Input",
          "position": { "x": 100, "y": 100 }
        },
        {
          "type": "code",
          "name": "Log Input",
          "position": { "x": 300, "y": 100 },
          "data": {
            "code": "console.log('[DEBUG] Input received:', JSON.stringify(input, null, 2)); return input;"
          }
        },
        {
          "type": "agent",
          "name": "Process",
          "position": { "x": 500, "y": 100 }
        },
        {
          "type": "code",
          "name": "Log Output",
          "position": { "x": 700, "y": 100 },
          "data": {
            "code": "console.log('[DEBUG] Agent output:', JSON.stringify(input, null, 2)); return input;"
          }
        }
      ],
      "edges": [
        { "source": "Input", "target": "Log Input" },
        { "source": "Log Input", "target": "Process" },
        { "source": "Process", "target": "Log Output" }
      ]
    },
    {
      "name": "Performance Monitor",
      "description": "Track execution time for blocks",
      "blocks": [
        {
          "type": "api_trigger",
          "name": "Start",
          "position": { "x": 100, "y": 100 }
        },
        {
          "type": "code",
          "name": "Start Timer",
          "position": { "x": 250, "y": 100 },
          "data": {
            "code": "return { ...input, _startTime: Date.now() };"
          }
        },
        {
          "type": "agent",
          "name": "Main Operation",
          "position": { "x": 400, "y": 100 }
        },
        {
          "type": "code",
          "name": "End Timer",
          "position": { "x": 550, "y": 100 },
          "data": {
            "code": "const duration = Date.now() - input._startTime; console.log(`Operation took ${duration}ms`); return { ...input, _duration: duration };"
          }
        },
        {
          "type": "condition",
          "name": "Check Performance",
          "position": { "x": 700, "y": 100 },
          "data": {
            "condition": "{{blocks.EndTimer.output._duration}} > 5000"
          }
        },
        {
          "type": "agent",
          "name": "Alert Slow",
          "position": { "x": 900, "y": 50 },
          "data": {
            "tools": ["slack_message"],
            "systemPrompt": "Alert: Operation exceeded 5 second threshold"
          }
        }
      ],
      "edges": [
        { "source": "Start", "target": "Start Timer" },
        { "source": "Start Timer", "target": "Main Operation" },
        { "source": "Main Operation", "target": "End Timer" },
        { "source": "End Timer", "target": "Check Performance" },
        { "source": "Check Performance", "target": "Alert Slow", "sourceHandle": "true" }
      ]
    },
    {
      "name": "HITL Approval Flow",
      "description": "Pause for human approval before action",
      "blocks": [
        {
          "type": "api_trigger",
          "name": "Request",
          "position": { "x": 100, "y": 100 }
        },
        {
          "type": "agent",
          "name": "Prepare Action",
          "position": { "x": 300, "y": 100 }
        },
        {
          "type": "hitl",
          "name": "Approval Gate",
          "position": { "x": 500, "y": 100 },
          "data": {
            "message": "Review and approve the following action:",
            "options": ["Approve", "Reject", "Request Changes"]
          }
        },
        {
          "type": "router",
          "name": "Route Decision",
          "position": { "x": 700, "y": 100 },
          "data": {
            "routes": [
              {
                "condition": "{{blocks.ApprovalGate.output.response}} === 'Approve'",
                "handle": "approve"
              },
              {
                "condition": "{{blocks.ApprovalGate.output.response}} === 'Reject'",
                "handle": "reject"
              }
            ],
            "defaultHandle": "changes"
          }
        }
      ],
      "edges": [
        { "source": "Request", "target": "Prepare Action" },
        { "source": "Prepare Action", "target": "Approval Gate" },
        { "source": "Approval Gate", "target": "Route Decision" }
      ]
    }
  ],
  "logQueryExamples": {
    "recentErrors": {
      "params": {
        "workspaceId": "ws_xxx",
        "level": "error",
        "limit": 20,
        "details": "full"
      },
      "description": "Get recent errors with full details"
    },
    "workflowPerformance": {
      "params": {
        "workspaceId": "ws_xxx",
        "workflowIds": "wf_abc",
        "dateFrom": "2024-01-01",
        "details": "full"
      },
      "description": "Analyze specific workflow performance"
    },
    "apiTriggerLogs": {
      "params": {
        "workspaceId": "ws_xxx",
        "trigger": "api",
        "level": "info,error",
        "limit": 100
      },
      "description": "All API-triggered executions"
    }
  }
}
